			<Item class="ModuleScript" referent="RBX455">
				<Properties>
					<string name="Name">README</string>
					<ProtectedString name="Source">return [[
{"joints": "one row per skin joint (Skeleton order): world x, y, z in metres with the armature root at the origin, then the world rotation x, y, z, w with the scales left out", "position": "through every translation, rotation and scale above the joint (Bevy's transform propagation)", "rotation": "the product of the local rotations from the root down (what a Roblox bone can show)", "sampling": "Bevy 0.19.1: clamped at the ends, exact on a key, LINEAR = lerp / glam slerp, STEP holds the earlier key", "blend": "layers in ascending clip-name order, folded with interpolate(acc, value, weight / weight so far)"}]]
</ProtectedString>
