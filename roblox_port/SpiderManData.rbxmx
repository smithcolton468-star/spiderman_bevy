			<Item class="ModuleScript" referent="RBX398">
				<Properties>
					<string name="Name">sandbox_presentation</string>
					<ProtectedString name="Source">return [[
{
  "provenance": "Presentation adjustments for delayed swing entry and smooth transitions. Camera: measured from recordings of the real game (ArkWeb swingrec, 2026-10-03): 5.4-5.7 m behind and 2-3 m above him, horizontal FOV from 93 degrees slow to 111 at speed (between HeroSwingCameraConfig's FOVBoostSpeedMin/Max, 10 and 33 m/s, at its FOVBlendUpSpeed); the yaw closes in on his heading a second after the last look input (ArkWeb's swing camera follow). The game's own swing camera code is not ported. Looking up (authored): the view can tilt up to 72 degrees; the boom comes in toward 2.5 m and keeps 0.35 m over the floor under it, and once it is down there the view alone tilts on up, so he can look up at the rooftops from the street.",
  "animation": {
    "swing_playback_rate": 2.4,
    "seek_response": 14.0,
    "max_seek_rate": 3.0,
    "swing_blend_seconds": 0.24,
    "release_blend_seconds": 0.28,
    "fall_blend_seconds": 0.36,
    "zip_blend_seconds": 0.2,
    "ground_blend_seconds": 0.24,
    "swing_intro_seconds": 0.45,
    "swing_dive_intro_seconds": 0.55,
    "swing_main_start_seconds": 0.6
  },
  "camera": {
    "follow_distance": 5.5,
    "pivot_height": 0.35,
    "base_pitch_degrees": 20.0,
    "auto_pitch_max_degrees": 5.0,
    "dive_pitch_degrees": 8.0,
    "pitch_response": 2.0,
    "pitch_rate_degrees": 8.0,
    "yaw_response": 2.5,
    "yaw_rate_degrees": 120.0,
    "auto_yaw_delay": 1.0,
    "focus_response": 12.0,
    "max_focus_error": 1.25,
    "horizontal_fov_degrees": 93.0,
    "distance_restore_rate": 1.5,
    "fast_fov_degrees": 111.0,
    "fov_speed_min": 10.0,
    "fov_speed_max": 33.0,
    "fov_rate_degrees": 13.0,
    "look_up_max_degrees": 72.0,
    "look_up_distance": 2.5,
    "ground_clearance": 0.35
  }
}
]]
</ProtectedString>
				</Properties>
